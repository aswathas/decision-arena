# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# graphify working output (the knowledge map itself lives in docs/ and the vault)
graphify-out/
*.graphify_*
.graphify_python
.graphify_root

# Installed copies of the Academy skills. The SOURCE of truth is skills/ in the
# repo; these are generated by `python tools/install_skills.py`, so committing
# them would just create a second copy to keep in sync.
.claude/skills/
.minimax/skills/

# NOTE: runs/ is deliberately NOT ignored.
# The raw calls behind every published number are the product. A number without
# its runs/*.jsonl behind it is marketing.
#
# NOTE: learning/ is deliberately NOT ignored either.
# progress.json and build_log.md are the learner's record of what they actually
# understood. That record is evidence, same as runs/.

