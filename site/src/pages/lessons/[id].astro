---
/**
 * One lesson, rendered from the repository's own lesson file.
 *
 * Mode: Read. The page is a technical document: the lesson's own words, the
 * numbers it claims, and the answer key kept behind a disclosure so it cannot
 * reach the reader before they have tried.
 *
 * The body is the file in `course/lessons/`, imported directly. The site does
 * not keep a copy of the course, so it cannot drift from it.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Foot from '../../components/Foot.astro';
import { LESSONS, quizFor, sectionsFor, nextInPath, prevInPath } from '../../data/course';
import { url } from '../../data/urls';

/**
 * The figure components, one per lesson. A lesson without a figure simply has
 * no entry, and the page renders the lesson without one - the figure is an
 * addition to the lesson, never a requirement for reading it.
 *
 * The glob is eager on purpose: a lazy glob hands back loader functions, and
 * `module.default` on a loader is undefined, so the figure silently never
 * renders. With `eager: true` the entry is the module itself.
 */
const FIGURES = import.meta.glob('../../figures/*.astro', { eager: true });

export function getStaticPaths() {
  return LESSONS.map((lesson) => ({
    params: { id: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = lesson;
const quiz = quizFor(lesson.id);
const sections = sectionsFor(lesson.id);
const next = nextInPath(lesson.id);
const prev = prevInPath(lesson.id);
const figureModule = FIGURES[`../../figures/${lesson.id}.astro`];
const Figure = figureModule?.default;
---

<Base
  title={`${lesson.id} - ${lesson.title} | Decision Arena Academy`}
  description={`Lesson ${lesson.id} of the Decision Arena Academy: ${lesson.title}. ${lesson.minutes} minutes, concepts: ${lesson.concepts.join(', ')}.`}
>
  <Nav />

  <main id="main">
    <article class="lesson">
      <header class="lesson__head">
        <p class="edge-code">
          phase {String(lesson.phase).padStart(2, '0')} &middot; {lesson.phaseTitle}
        </p>

        <dl class="meta">
          <div class="meta__item">
            <dt class="meta__label num">reading time</dt>
            <dd class="meta__value num">{lesson.minutes} min</dd>
          </div>
          <div class="meta__item">
            <dt class="meta__label num">concepts</dt>
            <dd class="meta__value num">{lesson.concepts.join(' · ')}</dd>
          </div>
          <div class="meta__item">
            <dt class="meta__label num">paths</dt>
            <dd class="meta__value num">{lesson.paths.join(' · ')}</dd>
          </div>
          {
            lesson.prereqs.length > 0 && (
              <div class="meta__item">
                <dt class="meta__label num">read first</dt>
                <dd class="meta__value num">
                  {lesson.prereqs.map((p) => (
                    <a href={url(`/lessons/${p}/`)}>{p}</a>
                  ))}
                </dd>
              </div>
            )
          }
          <div class="meta__item">
            <dt class="meta__label num">your file</dt>
            <dd class="meta__value num">{lesson.exercise_file}</dd>
          </div>
        </dl>
      </header>

      <div class="lesson__body">
        <div class="lesson__main">
          {Figure && (
            <div class="lesson__figure">
              <Figure />
            </div>
          )}

          <div class="prose">
            <Content />
          </div>

          <section class="turn" aria-labelledby="turn-title">
            <h2 id="turn-title" class="turn__title">Do it in the repo</h2>
            <p class="turn__body">
              The page above is the reading. The work happens in your checkout: you write
              <code>{lesson.exercise_file}</code> yourself, and the tutor checks the concepts, not
              the file.
            </p>
            <div class="command">
              <span class="command__prompt" aria-hidden="true">$</span>
              <span class="command__text">python tools/learn_state.py next</span>
            </div>
          </section>

          {
            quiz && (
              <section class="key" aria-labelledby="key-title">
                <h2 id="key-title" class="key__title">Quiz key</h2>
                <p class="key__note">
                  Answer out loud, in your own words, before you open anything. The explanations
                  are the teaching: read the one for the answer you got wrong and you should get
                  it right next time.
                </p>
                {quiz.questions.map((q, i) => (
                  <details class="question">
                    <summary class="question__summary">
                      <span class="question__index num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="question__concept num">{q.concept}</span>
                    </summary>
                    <div class="question__body">
                      <p class="question__prompt">{q.prompt}</p>
                      <ol class="question__options">
                        {q.options.map((option, oi) => (
                          <li
                            class={
                              oi === q.answer
                                ? 'question__option question__option--right'
                                : 'question__option'
                            }
                          >
                            <span class="question__marker num">{String.fromCharCode(97 + oi)}</span>
                            {option}
                          </li>
                        ))}
                      </ol>
                      <p class="question__explain">
                        <strong>The answer: {q.options[q.answer]}.</strong> {q.explain}
                      </p>
                    </div>
                  </details>
                ))}
              </section>
            )
          }
        </div>

        <aside class="rail" aria-label="In this lesson">
          <div class="rail__inner">
            <p class="edge-code">in this lesson</p>
            <ol class="rail__list">
              {
                sections.map((section) => (
                  <li>
                    <a href={`#${section.anchor}`}>{section.title}</a>
                  </li>
                ))
              }
            </ol>
            <p class="rail__foot">
              <a class="rail__link" href={url('/course/')}>The whole course</a>
            </p>
          </div>
        </aside>
      </div>

      <nav class="lessonnav" aria-label="Lesson navigation">
        <div class="lessonnav__side">
          {
            prev && (
              <a class="lessonnav__link" href={url(`/lessons/${prev.id}/`)}>
                <span class="edge-code">previous</span>
                <span class="lessonnav__title">
                  <span class="num">{prev.id}</span> {prev.title}
                </span>
              </a>
            )
          }
        </div>
        <div class="lessonnav__side lessonnav__side--end">
          {
            next && (
              <a class="lessonnav__link" href={url(`/lessons/${next.id}/`)}>
                <span class="edge-code">next</span>
                <span class="lessonnav__title">
                  <span class="num">{next.id}</span> {next.title}
                </span>
              </a>
            )
          }
        </div>
      </nav>
    </article>
  </main>

  <Foot />
</Base>

<style>
  .lesson {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .lesson__head {
    max-width: 60ch;
    margin-bottom: clamp(1.2rem, 2.4vw, 1.8rem);
  }

  /* The title is the lesson's own H1, rendered from the lesson file. The
     header above it carries the reference data, the way a spec sheet carries
     its stamp above the title. */
  .prose :global(h1) {
    font-size: var(--text-section);
    letter-spacing: -0.021em;
    margin: 0 0 1.4rem;
    max-width: 34ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem clamp(1.4rem, 3.5vw, 3rem);
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-rule);
  }

  .meta__item {
    min-width: 0;
  }

  .meta__label {
    margin: 0;
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .meta__value {
    margin: 0.25rem 0 0;
    font-size: var(--text-caption);
    color: var(--color-ink-70);
  }

  .meta__value a {
    color: var(--color-ink);
    text-decoration-color: var(--color-prussian);
    margin-right: 0.5rem;
  }

  /* The reading column and the rail that keeps its place beside it. */
  .lesson__body {
    display: grid;
    grid-template-columns: minmax(0, 68ch) 15rem;
    gap: 0 clamp(2rem, 5vw, 4rem);
    align-items: start;
    justify-content: start;
  }

  .lesson__main {
    min-width: 0;
  }

  .lesson__figure {
    margin-bottom: clamp(1.6rem, 3vw, 2.2rem);
  }

  .rail {
    position: sticky;
    top: 4.5rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
  }

  .rail__list {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    counter-reset: section;
  }

  .rail__list li {
    margin-bottom: 0.35rem;
    font-size: var(--text-caption);
    line-height: 1.45;
  }

  .rail__list a {
    color: var(--color-ink-70);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .rail__list a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-prussian);
  }

  .rail__foot {
    margin: 1.1rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-rule-soft);
  }

  .rail__link {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-70);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .rail__link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-prussian);
  }

  /* ------------------------------------------------------------------ prose
     The lesson body is the file from the repository, rendered by Astro's
     markdown pipeline. The rules below are the site's own: hairlines, one
     measure, mono for anything that is a number or a path. */
  .prose {
    max-width: 60ch;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    margin: 2.6rem 0 0.8rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-rule);
  }

  .prose :global(h3) {
    font-size: 1.05rem;
    margin: 1.8rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0 0 1.05rem;
    line-height: 1.65;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
    padding-left: 1.4rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  .prose :global(li::marker) {
    color: var(--color-ink-45);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-ink);
    text-decoration-color: var(--color-prussian);
  }

  .prose :global(code) {
    background: var(--color-ground-deep);
    border: 1px solid var(--color-rule-soft);
    padding: 0.08em 0.32em;
    font-size: 0.88em;
  }

  .prose :global(pre) {
    background: var(--color-ground-deep);
    border: 1px solid var(--color-rule);
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 0 0 1.2rem;
  }

  .prose :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.3rem;
    font-size: 0.94rem;
  }

  .prose :global(th) {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--color-ink-45);
    border-bottom: 1px solid var(--color-rule);
    padding: 0.45rem 0.8rem 0.45rem 0;
  }

  .prose :global(td) {
    border-bottom: 1px solid var(--color-rule-soft);
    padding: 0.5rem 0.8rem 0.5rem 0;
    vertical-align: top;
  }

  .prose :global(blockquote) {
    margin: 0 0 1.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-70);
  }

  .prose :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin: 2rem 0;
  }

  /* ------------------------------------------------------------------- turn */
  .turn {
    max-width: 60ch;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-rule);
  }

  .turn__title {
    font-size: 1.35rem;
    margin-bottom: 0.7rem;
  }

  .turn__body {
    color: var(--color-ink-70);
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  .turn__body code {
    background: var(--color-ground-deep);
    border: 1px solid var(--color-rule-soft);
    padding: 0.08em 0.32em;
    font-size: 0.88em;
  }

  .turn .command {
    max-width: 34rem;
  }

  /* -------------------------------------------------------------------- key */
  .key {
    max-width: 60ch;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-rule);
  }

  .key__title {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }

  .key__note {
    color: var(--color-ink-70);
    margin: 0 0 1.2rem;
    line-height: 1.6;
  }

  .question {
    border-top: 1px solid var(--color-rule-soft);
  }

  .question__summary {
    cursor: pointer;
    padding: 0.7rem 0;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    list-style: none;
  }

  .question__summary::-webkit-details-marker {
    display: none;
  }

  .question__summary::after {
    content: '+';
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--color-ink-45);
  }

  .question[open] .question__summary::after {
    content: '-';
  }

  .question__summary:hover .question__index {
    color: var(--color-prussian);
  }

  .question__index {
    color: var(--color-ink-45);
  }

  .question__concept {
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .question__body {
    padding: 0 0 1.2rem;
  }

  .question__prompt {
    font-weight: 600;
    margin: 0 0 0.8rem;
    line-height: 1.55;
  }

  .question__options {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .question__option {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.4rem;
    padding: 0.3rem 0;
    line-height: 1.55;
    color: var(--color-ink-70);
  }

  .question__marker {
    color: var(--color-ink-45);
  }

  .question__option--right {
    color: var(--color-ink);
  }

  .question__option--right .question__marker {
    color: var(--color-prussian);
    font-weight: 600;
  }

  .question__explain {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-rule-soft);
    color: var(--color-ink-70);
    line-height: 1.6;
  }

  .question__explain strong {
    color: var(--color-ink);
  }

  /* ------------------------------------------------------------------- nav */
  .lessonnav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-rule);
  }

  .lessonnav__side--end {
    text-align: right;
  }

  .lessonnav__link {
    display: inline-block;
    text-decoration: none;
    max-width: 40ch;
  }

  .lessonnav__link:hover .lessonnav__title {
    text-decoration: underline;
    text-decoration-color: var(--color-prussian);
    text-underline-offset: 0.2em;
  }

  .lessonnav__title {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .lessonnav__title .num {
    color: var(--color-ink-45);
    margin-right: 0.4rem;
  }

  @media (max-width: 1080px) {
    .lesson__body {
      grid-template-columns: 1fr;
    }

    /* Stacked, the rail becomes a contents line: the section names run
       together instead of standing in a column, so the title still lands
       near the top of the screen. */
    .rail {
      position: static;
      order: -1;
      margin-bottom: 1.6rem;
    }

    .rail__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 0.9rem;
    }

    .rail__list li {
      margin-bottom: 0;
    }
  }

  @media (max-width: 720px) {
    .lessonnav {
      grid-template-columns: 1fr;
    }

    .lessonnav__side--end {
      text-align: left;
    }
  }
</style>
