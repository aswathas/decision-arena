---
/**
 * The one navigation bar. The landing page and the course reader are the same
 * product seen from two doors, so they share the chrome exactly.
 */
const REPO = 'https://github.com/aswathas/decision-arena';
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__mark" aria-label="Decision Arena, home">
      <span class="nav__mark-name">Decision Arena</span>
      <span class="nav__mark-sub">the neutral harness</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      <a href="/#measures">What it measures</a>
      <a href="/#run">Run it</a>
      <a href="/#evidence">Evidence</a>
      <a href="/course/">Course</a>
      <a href={REPO} rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--color-rule);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--color-ground) 92%, transparent);
    backdrop-filter: blur(6px);
    z-index: 20;
  }

  .nav__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0.85rem clamp(1rem, 4vw, 3rem);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav__mark {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    text-decoration: none;
  }

  .nav__mark-name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav__mark-sub {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .nav__links a {
    text-decoration: none;
    color: var(--color-ink-70);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .nav__links a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-prussian);
  }

  @media (max-width: 720px) {
    .nav__inner {
      flex-wrap: wrap;
      gap: 0.6rem 1.5rem;
    }

    .nav__links {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nav__mark-sub {
      display: none;
    }
  }
</style>
