---
/**
 * The course index - the reader's table of contents.
 *
 * Mode: Read. The visitor here is trying to understand something, not decide
 * something, so this page is a table of contents with the numbers attached:
 * what each lesson teaches, how long it claims to take, and what it needs
 * before it. The course is read from the repository's own files, so this page
 * cannot drift from `course/`.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Foot from '../../components/Foot.astro';
import { PHASES, PATHS, TOTAL_LESSONS, FIRST_LESSON, LESSONS } from '../../data/course';

const totalMinutes = LESSONS.reduce((sum, l) => sum + l.minutes, 0);
const totalHours = Math.round(totalMinutes / 60);
---

<Base
  title="Decision Arena Academy - the whole course, in order"
  description="All 46 lessons of the Decision Arena Academy, in order: what each lesson teaches, how long it takes, what comes before it, and the quiz key once you have answered."
>
  <Nav />

  <main id="main">
    <section class="page" aria-labelledby="course-title">
      <div class="page__head">
        <h1 id="course-title" class="page__title">The whole course, in order.</h1>
        <p class="page__lead">
          Decision Arena Academy is {TOTAL_LESSONS} lessons, {TOTAL_LESSONS} quizzes, ten phases.
          Each lesson teaches one concept, hands you one small exercise to write, and ends with a
          quiz you answer before you are allowed to see the key.
        </p>
      </div>

      <dl class="facts">
        <div class="fact">
          <dt class="fact__label num">lessons</dt>
          <dd class="fact__value num">{TOTAL_LESSONS}</dd>
        </div>
        <div class="fact">
          <dt class="fact__label num">quizzes</dt>
          <dd class="fact__value num">{TOTAL_LESSONS}</dd>
        </div>
        <div class="fact">
          <dt class="fact__label num">phases</dt>
          <dd class="fact__value num">{PHASES.length}</dd>
        </div>
        <div class="fact">
          <dt class="fact__label num">paths</dt>
          <dd class="fact__value num">{PATHS.length}</dd>
        </div>
        <div class="fact">
          <dt class="fact__label num">reading time</dt>
          <dd class="fact__value num">{totalHours} h</dd>
        </div>
      </dl>

      {
        FIRST_LESSON && (
          <div class="start">
            <div class="start__body">
              <p class="edge-code">start here</p>
              <p class="start__title">
                <span class="start__id num">{FIRST_LESSON.id}</span>
                {FIRST_LESSON.title}
              </p>
              <p class="start__meta num">
                {FIRST_LESSON.minutes} min &middot; {FIRST_LESSON.concepts.join(' · ')}
              </p>
            </div>
            <a class="action" href={`/lessons/${FIRST_LESSON.id}/`}>
              Read {FIRST_LESSON.id}
              <span class="action__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        )
      }

      <h2 class="section-title">The curriculum</h2>
      <p class="section-lede">
        Phases run in order. Within a phase the lessons are in the order you should meet them, and
        every lesson lists the ones it assumes you have already read.
      </p>

      <ol class="toc">
        {
          PHASES.map((phase) => (
            <li class="phaseblock">
              <div class="phaseblock__head">
                <span class="phaseblock__num num">{String(phase.id).padStart(2, '0')}</span>
                <span class="phaseblock__title">{phase.title}</span>
                <span class="phaseblock__count num">
                  {phase.lessons.length} lessons &middot; {phase.minutes} min
                </span>
              </div>
              <ol class="lessons">
                {phase.lessons.map((lesson) => (
                  <li class="lessonrow">
                    <a class="lessonrow__link" href={`/lessons/${lesson.id}/`}>
                      <span class="lessonrow__id num">{lesson.id}</span>
                      <span class="lessonrow__title">{lesson.title}</span>
                      <span class="lessonrow__minutes num">{lesson.minutes} min</span>
                    </a>
                    <p class="lessonrow__concepts num">
                      {lesson.concepts.join(' · ')}
                      {lesson.prereqs.length > 0 && (
                        <span class="lessonrow__prereq">after {lesson.prereqs.join(', ')}</span>
                      )}
                    </p>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>

      <h2 class="section-title">The three paths</h2>
      <p class="section-lede">
        The same lessons, three different routes through them. A lesson can sit on more than one
        path, and every lesson is on at least one.
      </p>

      <div class="paths">
        {
          PATHS.map((path) => (
            <div class="path">
              <div class="path__intro">
                <div class="path__head">
                  <p class="path__id num">{path.id}</p>
                  <p class="path__count num">
                    {path.lessons.length} lessons &middot;{' '}
                    {path.lessons.reduce((sum, l) => sum + l.minutes, 0)} min
                  </p>
                </div>
                <p class="path__label">{path.label}</p>
              </div>
              <ol class="path__seq num">
                {path.lessons.map((lesson) => (
                  <li>
                    <a class="path__id-link" href={`/lessons/${lesson.id}/`}>
                      {lesson.id}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>

      <div class="note">
        <p>
          <strong>This page teaches. It does not keep the record.</strong> Reading a lesson here
          shows you the lesson. Whether you <em>understood</em> it is tracked by the tutor, per
          concept, in <code>learning/progress.json</code> - because reading a page and owning a
          concept are not the same thing, and a page cannot tell the difference.
        </p>
        <p>
          The honest loop is the one in the repository: clone it, run
          <code>python tools/learn_state.py next</code>, write the exercise yourself, and let the
          agent quiz you. The answer key on each lesson page is there for when you have already
          answered, and the quiz never hands you an answer before you have tried.
        </p>
      </div>
    </section>
  </main>

  <Foot />
</Base>

<style>
  .page {
    max-width: 1440px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }

  .page__head {
    max-width: 64rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .page__title {
    font-size: var(--text-display);
    margin: 0.5rem 0 0.7rem;
  }

  .page__lead {
    color: var(--color-ink-70);
    font-size: var(--text-lead);
    line-height: 1.5;
    margin: 0;
    max-width: 58ch;
  }

  /* The numbers, in a row, the way a plot carries its scale. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.5rem, 4vw, 3.5rem);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--color-rule);
  }

  .fact {
    padding-bottom: 0.9rem;
  }

  .fact__label {
    margin: 0;
    font-size: var(--text-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .fact__value {
    margin: 0.2rem 0 0;
    font-size: var(--text-section);
    line-height: 1.1;
  }

  /* The first door. */
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 1px solid var(--color-rule);
    padding: 1.4rem 1.6rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .start__body {
    min-width: 0;
  }

  .start__title {
    font-size: var(--text-lead);
    font-weight: 600;
    margin: 0.35rem 0 0.4rem;
    max-width: 44ch;
  }

  .start__id {
    color: var(--color-prussian);
    margin-right: 0.6rem;
  }

  .start__meta {
    margin: 0;
    font-size: var(--text-micro);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .section-title {
    font-size: var(--text-section);
    margin-bottom: 0.6rem;
  }

  .section-lede {
    color: var(--color-ink-70);
    max-width: 58ch;
    margin: 0 0 1.6rem;
  }

  /* ------------------------------------------------------------ the syllabus */
  .toc {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding: 0;
  }

  .phaseblock {
    border-top: 1px solid var(--color-rule);
    padding-top: 1rem;
    margin-bottom: 1.6rem;
  }

  .phaseblock__head {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    gap: 0 1rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .phaseblock__num {
    color: var(--color-prussian);
  }

  .phaseblock__title {
    font-weight: 600;
  }

  .phaseblock__count {
    font-size: var(--text-micro);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lessonrow {
    border-top: 1px solid var(--color-rule-soft);
    padding: 0.55rem 0 0.5rem;
  }

  .lessonrow__link {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) 4.5rem;
    gap: 0 1rem;
    align-items: baseline;
    text-decoration: none;
  }

  .lessonrow__link:hover .lessonrow__title {
    text-decoration: underline;
    text-decoration-color: var(--color-prussian);
    text-underline-offset: 0.2em;
  }

  .lessonrow__id {
    color: var(--color-ink-45);
  }

  .lessonrow__title {
    font-weight: 500;
  }

  .lessonrow__minutes {
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-45);
    text-align: right;
  }

  .lessonrow__concepts {
    margin: 0.15rem 0 0 4.2rem;
    font-size: var(--text-caption);
    letter-spacing: 0.02em;
    color: var(--color-ink-45);
  }

  .lessonrow__prereq {
    margin-left: 0.9rem;
    color: var(--color-ink-45);
  }

  /* ------------------------------------------------------------------ paths
     The three routes, stacked. Each sequence is a run of lesson ids, one per
     line, because a run of forty-six ids in a paragraph is not a path. */
  .paths {
    display: grid;
    gap: 1.8rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .path {
    border-top: 1px solid var(--color-rule);
    padding-top: 0.9rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 0.6rem 2.5rem;
    align-items: start;
  }

  .path__intro {
    min-width: 0;
  }

  .path__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .path__id {
    margin: 0;
    font-size: var(--text-caption);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-prussian);
  }

  .path__count {
    margin: 0;
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-45);
  }

  .path__label {
    margin: 0.5rem 0 0;
    max-width: 34ch;
    color: var(--color-ink-70);
  }

  .path__seq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    font-size: var(--text-caption);
  }

  .path__seq li {
    position: relative;
  }

  .path__seq li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -0.42rem;
    top: 50%;
    width: 0.3rem;
    height: 1px;
    background: var(--color-rule);
  }

  .path__id-link {
    display: inline-block;
    text-decoration: none;
    color: var(--color-ink-70);
    border: 1px solid var(--color-rule-soft);
    padding: 0.12rem 0.4rem;
  }

  .path__id-link:hover {
    color: var(--color-ink);
    border-color: var(--color-prussian);
  }

  /* ------------------------------------------------------------------- note */
  .note {
    border-top: 1px solid var(--color-rule);
    padding-top: 1.2rem;
    max-width: 60ch;
  }

  .note p {
    margin: 0 0 0.9rem;
    color: var(--color-ink-70);
    line-height: 1.6;
  }

  .note strong {
    color: var(--color-ink);
  }

  @media (max-width: 720px) {
    .path {
      grid-template-columns: 1fr;
    }

    .lessonrow__link {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .lessonrow__minutes {
      grid-column: 2;
      text-align: left;
    }

    .lessonrow__concepts {
      margin-left: 4rem;
    }

    .phaseblock__head {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }

    .phaseblock__count {
      grid-column: 2;
    }
  }
</style>
