# DecisionArena credentials. Copy to .env and fill in. Never commit the filled file.
# PowerShell:  setx TYPESAFE_API_KEY "..."
#             setx CLOUDFLARE_ACCOUNT_ID "..."
#             setx CLOUDFLARE_AUTH_TOKEN "..."

# TypeSafe Jev - https://typesafe.ai (docs: docs.typesafe.ai)
TYPESAFE_API_KEY=

# Cloudflare Workers AI - dashboard.cloudflare.com (Workers AI -> API Tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Any OpenAI-compatible gateway, e.g. pplx-decider-v1-27b via OpenRouter
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
